{
	"name": "ree-templates",
	"project-type": "utility",
	"displayName": "ree Templates",
	"description": "Syntax highlighting and formatting for REE templates (via reettier)",
	"version": "2.0.10",
	"publisher": "reepolee",
	"license": "MIT",
	"icon": "icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/reepolee/ree-templates"
	},
	"bugs": {
		"url": "https://github.com/reepolee/ree-templates/issues"
	},
	"homepage": "https://github.com/reepolee/ree-templates#readme",
	"engines": {
		"vscode": "^1.107.0"
	},
	"categories": [
		"Programming Languages",
		"Formatters",
		"Themes"
	],
	"main": "./dist/extension.js",
	"workspaces": [
		"lsp"
	],
	"contributes": {
		"languages": [
			{
				"id": "ree",
				"aliases": [
					"Ree Template",
					"ree"
				],
				"extensions": [
					".ree"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "ree",
				"scopeName": "text.html.ree",
				"path": "./syntaxes/ree.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "ree.format",
				"title": "Format ree Template"
			},
			{
				"command": "ree.checkFormatters",
				"title": "ree: Check Formatters (path and version)"
			},
			{
				"command": "ree.formatWithReprint",
				"title": "ree: Format with reprint"
			},
			{
				"command": "ree.formatWithMarkup",
				"title": "ree: Format with markup wrapping"
			},
			{
				"command": "ree.expandReeTag",
				"title": "ree: Expand ReeTag (inline component here)"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "ree.expandReeTag",
					"when": "editorLangId == ree",
					"group": "1_modification"
				}
			]
		},
		"configuration": {
			"title": "ree Templates",
			"properties": {
				"ree.reettierPath": {
					"type": "string",
					"default": "",
					"description": "Path to the reettier executable. Leave empty to use reettier from PATH."
				},
				"ree.translation.defaultLocale": {
					"type": "string",
					"default": "en-US",
					"scope": "window",
					"description": "Default locale to display in inline translation decorations and hover."
				},
				"ree.server.command": {
					"type": "string",
					"default": "bun",
					"description": "Override the command used to launch the bundled ree-lsp server. Defaults to Bun."
				},
				"ree.server.args": {
					"type": "array",
					"default": [
						"run",
						"src/server.ts",
						"--stdio"
					],
					"description": "Arguments passed to the server command."
				},
				"ree.server.cwd": {
					"type": "string",
					"default": "",
					"description": "Working directory for an explicitly configured language server command."
				}
			}
		},
		"iconThemes": [
			{
				"id": "ree-icons",
				"label": "ree Icons",
				"path": "./themes/ree-icon-theme.json"
			}
		],
		"configurationDefaults": {
			"[ree]": {
				"editor.defaultFormatter": "reepolee.ree-templates"
			},
			"emmet.includeLanguages": {
				"ree": "html"
			}
		}
	},
	"scripts": {
		"compile": "npm run check-types && npm run lsp:typecheck && node esbuild.js",
		"check-types": "tsc --noEmit",
		"lsp:typecheck": "npm --workspace ree-lsp run typecheck",
		"lsp:test": "npm --workspace ree-lsp run test",
		"test": "node --test test/expand-ree-tag.test.mjs test/folding-ranges.test.mjs test/i18n-locale-contract.test.mjs test/ree-template-syntax.test.mjs",
		"watch": "node esbuild.js --watch & tsc --noEmit --watch --project tsconfig.json",
		"vscode:prepublish": "npm run package",
		"package": "npm run check-types && npm run lsp:typecheck && node esbuild.js --production",
		"bundle": "git push && pnpm version patch && git push &&  npm run package && vsce package --no-update-package-json",
		"publish": "vsce publish"
	},
	"devDependencies": {
		"@types/node": "25.9.3",
		"@types/vscode": "1.107.0",
		"@vscode/vsce": "3.9.2",
		"esbuild": "0.28.1",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"vscode-languageclient": "9.0.1"
	},
	"allowScripts": {
		"keytar@7.9.0": true,
		"esbuild@0.28.1": true,
		"@vscode/vsce-sign@2.0.9": true
	}
}
